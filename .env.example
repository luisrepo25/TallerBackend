DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Postgres (session pooler, IPv4-compatible)
# Pide estos valores al equipo por un canal privado (no van en git).
# Se obtienen en: Supabase -> Project Settings -> Database -> Connect -> Session pooler
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<password>
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432

# Cloudinary (evidencias fotograficas de las inspecciones)
# Cloud name y API key: Cloudinary -> Settings -> API Keys. El API Secret NUNCA va en git.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
CLOUDINARY_FOLDER=evidencias_campanias

# Microservicio de clustering K-Means (Fase 5). Repo/carpeta aparte: MicroservicioML.
# ML_API_KEY debe ser IDENTICA a la del .env del microservicio (la inventas tu: texto largo y aleatorio).
# Desde Docker en Windows/Mac, host.docker.internal apunta a tu maquina (el ML corre en el puerto 8001).
ML_SERVICE_URL=http://host.docker.internal:8001
ML_API_KEY=change-me
ML_TIMEOUT_SEGUNDOS=60

# Conexion persistente a Supabase (segundos). 0 = una por peticion (lento). Para desarrollo: 300
DB_CONN_MAX_AGE=0
